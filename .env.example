# ============================================================================
#  Скопируй в .env и заполни реальными значениями. .env НИКОГДА не коммитить.
#  Получить ключи: Supabase Dashboard → Project Settings → API
# ============================================================================

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...   # только для бэкенда, обходит RLS
SUPABASE_ANON_KEY=eyJ...anon...                   # публичный (опционально, для фронтенда)

# --- Telegram bot ---
TG_BOT_TOKEN=123456:ABC...                        # @BotFather

# --- Anthropic (Claude, только для объяснений при неверном ответе) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram bot (Stage 4: точка входа + проверка подписок) ---
TG_BOT_TOKEN=123456:ABC...                     # @BotFather; пусто = проверка подписок выключена (dev)
WEBAPP_URL=https://your-app.vercel.app          # HTTPS URL мини-аппа (http://localhost НЕ откроется в TG)
BACKEND_URL=http://127.0.0.1:8000               # куда боту стучаться к API (на Railway — публичный URL)
VERIFY_SUBSCRIPTIONS=true                       # проверять реальную подписку перед начислением за «Задание»
